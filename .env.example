# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in the deployment secret manager; never commit the real value.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL=""

# ADMIN_SECRET_KEY: Required to unlock the Admin Dashboard & Secrets Panel.
# REQUIRED: set this only in the deployment secret manager. Do not commit the value.
ADMIN_SECRET_KEY=

NEXT_PUBLIC_DERIV_APP_ID=
NEXT_PUBLIC_DERIV_REDIRECT_URI=
NEXT_PUBLIC_DERIV_APP_NAME=Rise Fall Trading App
NEXT_PUBLIC_DERIV_REFERRAL_LINK=
NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade,account_manage
NEXT_PUBLIC_DERIV_ENV=production
NEXT_PUBLIC_FONT_FAMILY=Roboto

# DATABASE_URL: PostgreSQL / Neon Database connection string.
DATABASE_URL=

# ML training execution budget. Keep at 1 on small Render instances.
# The native Python runtime derives per-job CPU/thread limits from this value.
ML_TRAINING_CONCURRENCY=1

# Dataset Builder runtime controls.
# Optional: leave unset for no application-level asset-count cap; set only when the deployment resource budget requires one.
DATASET_BUILD_MAX_ASSETS=
# Required client polling interval for dataset-build progress, in milliseconds.
DATASET_BUILD_POLL_INTERVAL_MS=2000

# Retraining automation schedule interval, in milliseconds (e.g. 86400000 ms for 24 hours).
ML_RETRAIN_INTERVAL_MS=86400000

# Native training request timeout. Default is 15 minutes.
# On timeout the Python worker is terminated and restarted cleanly; the run is marked timed_out.
# Value is milliseconds; allowed range is 60 seconds to 2 hours.
ML_TRAINING_TIMEOUT_MS=900000

# Maximum age of a training heartbeat before the database reconciles a run as stale.
# Default is 20 minutes. Keep this comfortably above the heartbeat interval.
# Value is milliseconds; allowed range is 1 minute to 24 hours.
ML_TRAINING_STALE_AFTER_MS=1200000

# UPSTASH REDIS CONFIG: Used for caching heavy queries and tracking rate-limit blocks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RENDER DEPLOYMENT MONITORING & REMOTE ML RUNTIME
RENDER_API_KEY=
RENDER_SERVICE_ID=
# RENDER_BACKEND_URL: Used by Netlify edge to forward ML inference commands to your Python-enabled Render container (e.g. https://deriv-ai-trading-hub.onrender.com)
RENDER_BACKEND_URL=

# 1. ADMIN ML DRIFT & INCIDENT ALERTS (One-way outgoing notifications & interactive control plane)
ADMIN_ALERT_EMAIL=olalekan4565@gmail.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# REQUIRED FOR TELEGRAM CONTROL PLANE: Comma-separated numeric Telegram User IDs allowed to execute admin actions
ALERT_TELEGRAM_ADMIN_USER_IDS=

# 2. INTERACTIVE TELEGRAM TRADING TERMINAL (Two-way user webhook & trade execution)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# REQUIRED: strong 32+ character secret used to encrypt Deriv tokens at rest.
TELEGRAM_AUTH_SECRET=
# REQUIRED: 16-256 character Telegram webhook secret token registered via setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# TELEGRAM STATIC ASSETS (CLOUDINARY OR OTHER PUBLIC CDN)
# Provide direct URLs to your image assets. 
# Do not use application URLs if the app is behind a security wall.
TELEGRAM_MAIN_MENU_IMAGE_URL=
TELEGRAM_BULLISH_IMAGE_URL=
TELEGRAM_BEARISH_IMAGE_URL=
TELEGRAM_PROFIT_IMAGE_URL=
TELEGRAM_LOST_IMAGE_URL=
TELEGRAM_SETTINGS_IMAGE_URL=
TELEGRAM_MY_ACCOUNT_IMAGE_URL=
TELEGRAM_BALANCE_EXPIRED_IMAGE_URL=
TELEGRAM_FAQ_IMAGE_URL=
