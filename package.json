    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@types/ws": "^8.18.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "next-themes": "^0.4.4",
    "opossum": "^9.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rate-limiter-flexible": "^7.2.0",
    "react": "19.2.8",
    "react-day-picker": "^9.0.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "vaul": "^1.1.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/opossum": "^8.1.9",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2"
