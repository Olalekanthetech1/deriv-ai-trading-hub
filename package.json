{
  "name": "my-trading-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build",
    "start": "next start -H 0.0.0.0",
    "ml:worker": "tsx scripts/ml-training-worker.ts",
    "dataset:worker": "tsx scripts/dataset-build-worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "copy-smartcharts-assets": "node scripts/copy-smartcharts-assets.js",
    "verify-ml-architecture": "node scripts/verify-ml-architecture.mjs",
    "verify-gate6-legacy": "node scripts/tests/gate6-legacy-boundary-guard.mjs",
    "verify-signal-forensics": "node scripts/tests/signal-forensics-invariants.mjs",
    "verify-model-operations": "node scripts/tests/model-operations-invariants.mjs",
    "verify-legacy-model-registry-migration": "node scripts/tests/legacy-model-registry-migration-invariants.mjs",
    "verify-ml-config": "node scripts/tests/ml-config-invariants.mjs",
    "verify-retraining-automation": "node scripts/tests/retraining-automation-invariants.mjs",
    "verify-asset-aware-strategy": "node scripts/tests/asset-aware-strategy-invariants.mjs",
    "verify-ml-promotion-metrics": "node scripts/tests/ml-promotion-metrics-invariants.mjs",
    "verify-dataset-builder-scope": "node scripts/tests/dataset-builder-scope-contract-invariants.mjs",
    "verify-dataset-batch-deletion": "node scripts/tests/dataset-batch-deletion-invariants.mjs",
    "verify-prediction-trading-integration": "node scripts/tests/prediction-trading-integration-invariants.mjs",
    "verify-production-model-contract": "node scripts/tests/production-model-contract-invariants.mjs",
    "verify-ml-horizon-contract": "node scripts/tests/ml-horizon-contract-invariants.mjs",
    "verify-ml-horizon-cohort": "node scripts/tests/ml-horizon-cohort-invariants.mjs",
    "verify-live-signal-no-cache": "node scripts/tests/live-signal-no-cache-invariants.mjs",
    "backfill-production-model-artifacts": "tsx scripts/backfill-production-model-artifacts.ts",
    "db:migrate-legacy-model-registry": "node scripts/migrate-legacy-model-registry-v2.mjs",
    "db:storage:audit": "node scripts/db-storage-maintenance.mjs",
    "db:storage:prune": "node scripts/db-storage-maintenance.mjs --prune-ticks",
    "postinstall": "node scripts/copy-smartcharts-assets.js",
    "prebuild": "node scripts/copy-smartcharts-assets.js && npm run verify-ml-architecture && npm run verify-gate6-legacy && npm run verify-signal-forensics && npm run verify-model-operations && npm run verify-legacy-model-registry-migration && npm run verify-ml-config && npm run verify-retraining-automation && npm run verify-asset-aware-strategy && npm run verify-ml-promotion-metrics && npm run verify-dataset-builder-scope && npm run verify-dataset-batch-deletion && npm run verify-prediction-trading-integration && npm run verify-production-model-contract && npm run verify-ml-horizon-contract && npm run verify-ml-horizon-cohort && npm run verify-live-signal-no-cache && npm run verify-telegram-symbol-universe && npm run verify-telegram-admin-control-plane && npm run verify-telegram-telemetry-alert",
    "verify-telegram-symbol-universe": "node scripts/tests/telegram-symbol-universe-invariants.mjs",
    "verify-telegram-admin-control-plane": "tsx scripts/tests/telegram-admin-control-plane-invariants.ts",
    "verify-telegram-telemetry-alert": "tsx scripts/tests/telegram-telemetry-alert-invariants.ts"
  },
  "dependencies": {
